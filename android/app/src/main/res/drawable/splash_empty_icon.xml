<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ shows the launcher adaptive icon (e.g. "W") if windowSplashScreenAnimatedIcon
     is unset. Transparent placeholder keeps the splash a flat black surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact wallet widget: title + flexible KPI + label pinned at the bottom.
  The balance row uses layout_weight so "Disponible" is never clipped when the
  launcher still allocates a short 2x1 cell.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_wallet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_wallet_label"
        android:textColor="@color/wayo_widget_orange"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_wallet_balance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/wayo_widget_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_wallet_available_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_available"
        android:textColor="@color/wayo_widget_muted"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/widget_wallet_pending_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_wallet_pending_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_pending"
            android:textColor="@color/wayo_widget_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_wallet_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/wayo_widget_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/wayo_widget_muted"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/wayo_widget_orange"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/wayo_widget_muted"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
